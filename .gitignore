# --- Data (never versioned; regenerable with `forecast-lab fetch`) ---
# The raw series is not a repo artefact: Dukascopy is a public CDN, so anyone can
# rebuild it. Two things ARE versioned and live elsewhere on purpose:
# docs/status/data-manifest.json, which ties a published result to a hash
# (ADR-002 sec. 7), and tests/fixtures/, the synthetic data the gates run on.
data/

# --- Environment and secrets ---
.env
.env.*
!.env.example

# --- Private working material (glossary, course notes) ---
docs/_private/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments / uv ---
.venv/
.uv/

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
